# ---------------------------------------------------------------
# PATIENT DATA — human-subjects material. Never commit.
# No leading slash => these match at ANY depth, not just the repo
# root. That is deliberate: the old rule was `config/Centralized-*`,
# which silently failed the moment the file sat somewhere else.
# ---------------------------------------------------------------
# `data/*` rather than `data/`: git will not look inside an excluded directory,
# so the demo exception below only works if the directory itself stays visible.
data/*
Centralized-NIDAQ-System*
*_eventonly.csv

# ...except the synthetic demo recordings, generated by src/make_demo_data.py and
# containing no real data. They ship so the published app has something to show
# without any patient recording being involved.
!data/demo/

# Roster: participant IDs x session dates x clinical notes (sheet "draft").
docs/Pharma-rundown.xlsx

# The column layout, but filled with a real subject's measurements: 728 rows
# carrying a participant code, a session date and its EMG values. The authoritative
# layout is SCHEMA in src/harmonize.py, which does ship.
docs/Table-layout.csv

# Self-check output. Names session folders, which are subject codes plus dates.
# Use `selfcheck.py --anonymise` for a version that is safe to share outside the lab.
report.txt

# Process-flow workbook. The DATA-PROCESSING-FLOW sheet quotes a real filename —
# a subject code together with the exact minute of their session.
docs/data_processing_flow_06012026.xlsx

# Editor and assistant working directories, not part of the project.
.claude/
.agents/
.vscode/

# Reference papers. Journal PDFs cannot be redistributed, so they stay local; the
# method itself is written up in docs/cusum-method.md, which does ship.
docs/*.pdf

# Notebook outputs embed a real subject's EMG traces and P2P/AUC values,
# and subject IDs appear in the filenames. Ignoring the notebooks wholesale.
# NOTE: this means notebook code is NOT version-controlled. If you later want
# the code in git without the data, drop this rule and use nbstripout instead.
notebooks/*.ipynb

# ---------------------------------------------------------------
# Environment / build
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/


# Notebooks

.ipynb_checkpoints/

# ---------------------------------------------------------------
# Outputs / derived results
# ---------------------------------------------------------------
outputs/
results/

# ---------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------
.DS_Store
.vscode/
.idea/
